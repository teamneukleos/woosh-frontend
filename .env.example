# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/woosh?schema=public"

# Auth.js
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# Stable across production instances so Server Action references remain valid
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="replace-with-openssl-rand-base64-32"

# Paystack (MVP provider — leave empty for test-mode wallet/payouts)
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
# 32+ byte key for AES-GCM encryption of creator bank account numbers
PAYOUT_ACCOUNT_ENCRYPTION_KEY="replace-with-openssl-rand-base64-32"

# Social OAuth (leave empty until provider apps are ready)
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_VERSION="v26.0"
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Auth.js Google/Apple sign-in (buttons still render if empty; OAuth then fails).
# Google: add {AUTH_URL}/api/auth/callback/google (same client as YouTube is OK).
# Apple: Services ID + client-secret JWT; add {AUTH_URL}/api/auth/callback/apple
APPLE_ID=""
APPLE_SECRET=""
# 32+ byte secret used for AES-GCM encryption of provider access tokens
OAUTH_TOKEN_ENCRYPTION_KEY="replace-with-openssl-rand-base64-32"
# Local-only: allow ACTIVE social connect without provider apps
WOOSH_ALLOW_DEV_OAUTH="false"

# Email (Resend — leave empty to log to console)
RESEND_API_KEY=""
EMAIL_FROM="Woosh <onboarding@resend.dev>"

# File storage (optional S3 — otherwise local uploads/)
# Keep the bucket private. Direct creator uploads use 10-minute presigned PUTs.
# Allow PUT + Content-Type from NEXT_PUBLIC_APP_URL in the bucket CORS policy.
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="eu-west-1"

# Accept rate threshold for managers (NGN) — above needs finance/owner
WOOSH_ACCEPT_RATE_THRESHOLD="500000"

# Scheduler authentication for POST /api/internal/* cron jobs
WOOSH_CRON_SECRET="replace-with-openssl-rand-base64-32"
# Public origin of the deployed app (GitHub Actions secret WOOSH_APP_URL)
# WOOSH_APP_URL="https://app.woosh.example"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
