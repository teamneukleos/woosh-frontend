# Auth.js session cookie (Next still owns the browser session)
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# Stable across production instances so Server Action references remain valid
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="replace-with-openssl-rand-base64-32"

# App origin
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Nest API (BFF). Local default is http://localhost:4000/api
WOOSH_API_URL="http://localhost:4000/api"

# File storage is Cloudinary on Nest (woosh-backend/.env).
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
# CLOUDINARY_FOLDER="woosh"

# --- Moved to Nest (woosh-backend/.env). Commented so Next does not pretend to own them. ---

# PAYSTACK_SECRET_KEY=""
# PAYSTACK_PUBLIC_KEY=""
# PAYOUT_ACCOUNT_ENCRYPTION_KEY="replace-with-openssl-rand-base64-32"
# WOOSH_ACCEPT_RATE_THRESHOLD="500000"

# Social channel OAuth lives on Nest. Keep Google/Apple Auth.js keys commented
# (login is credentials-only). YouTube uses Nest GOOGLE_CLIENT_ID/SECRET.
# Google redirect URI (local): {AUTH_URL}/creators/social/youtube/callback
# Instagram OAuth is Composio on Nest (woosh-backend/.env). Do not put COMPOSIO keys here.
# Callback (local): {AUTH_URL}/creators/social/instagram/callback
# META_APP_ID=""
# META_APP_SECRET=""
# META_GRAPH_VERSION="v26.0"
# TIKTOK_CLIENT_KEY=""
# TIKTOK_CLIENT_SECRET=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# APPLE_ID=""
# APPLE_SECRET=""
# OAUTH_TOKEN_ENCRYPTION_KEY="replace-with-openssl-rand-base64-32"
# WOOSH_ALLOW_DEV_OAUTH="false"

# Email — Nest MailService (Resend, or console stub when the key is empty).
# RESEND_API_KEY=""
# EMAIL_FROM="Woosh <onboarding@resend.dev>"

# Cron secret belongs on Nest. Next /api/internal/* forwards the Bearer header.
# WOOSH_CRON_SECRET="replace-with-openssl-rand-base64-32"
